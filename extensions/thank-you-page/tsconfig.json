{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "target": "ES2020",
    "checkJs": true,
    "allowJs": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "@shopify/react-testing/matchers",
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "paths": {
      "foundation/*": [
        "./src/foundation/*"
      ],
      "tests/*": [
        "./src/tests/*"
      ],
      "mocks/*": [
        "./src/tests/mocks/*"
      ]
    },
    "noEmit": true,
    "strict": false
  },
  "include": [
    "./src",
    "./shopify.d.ts"
  ],
  "exclude": [
    "dist",
    "public",
    "node_modules/**/*"
  ]
}
